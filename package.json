{
  "name": "modpack-lock",
  "version": "0.8.0",
  "description": "Creates a modpack lockfile for files hosted on Modrinth (mods, resource packs, shaders and datapacks)",
  "bugs": {
    "url": "https://github.com/nickesc/modpack-lock/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nickesc/modpack-lock.git"
  },
  "homepage": "https://nickesc.github.io/modpack-lock",
  "license": "MIT",
  "author": "N. Escobar <nick@nickesc.io> (https://nickesc.github.io/)",
  "type": "module",
  "main": "build/modpack-lock.js",
  "bin": {
    "modpack-lock": "build/cli.js"
  },
  "keywords": [
    "modrinth",
    "minecraft",
    "modpack",
    "lockfile"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest --run",
    "start": "tsx src/cli.ts",
    "docs": "typedoc",
    "modpack-lock": "tsx src/cli.ts",
    "prepare": "npm run build"
  },
  "files": [
    "README.md",
    "LICENSE",
    "package.json",
    "build/**/*"
  ],
  "dependencies": {
    "@sindresorhus/slugify": "^3.0.0",
    "commander": "^14.0.3",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.3.3",
    "@types/prompts": "^2.4.9",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^10.0.0",
    "globals": "^17.3.0",
    "tsx": "^4.21.0",
    "typedoc": "^0.28.17",
    "typedoc-github-theme": "^0.3.1",
    "typescript": "^5.9.3",
    "unzipper": "^0.12.3",
    "vitest": "^4.0.16"
  }
}
